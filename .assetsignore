# Cloudflare asset exclusion list

# CRITICAL — exclude all git internals (multiple pattern forms to be safe)
.git
.git/
.git/**
.gitignore
.gitattributes

# Build/config files
.assetsignore
wrangler.jsonc
package.json
package-lock.json
node_modules
node_modules/

# Source files
site_generator.py
__pycache__
__pycache__/
*.pyc

# Documentation (kept in repo, not deployed)
MANIFEST.md
MANIFEST.txt
README.md

# System cruft
.DS_Store
.vscode
.vscode/
.idea
.idea/
